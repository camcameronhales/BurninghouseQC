<?xml version="1.0" encoding="UTF-8"?>
<!--
  Burninghouse QC — macOS launchd agent.

  Edit the paths below to match the install, then:

    cp service/com.burninghouse.qc.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.burninghouse.qc.plist

  See docs/service-setup.md for the full walkthrough, including the two things
  that reliably bite on macOS: launchd's PATH, and Full Disk Access.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.burninghouse.qc</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/Shared/BurninghouseQC/.venv/bin/python</string>
    <string>-m</string>
    <string>burninghouse_qc.cli</string>
    <string>-c</string>
    <string>/Users/Shared/BurninghouseQC/config.toml</string>
    <string>watch</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/Shared/BurninghouseQC</string>

  <!--
    launchd does not inherit a shell PATH, so FFmpeg and Tesseract have to be
    named explicitly. /opt/homebrew/bin is Apple Silicon; /usr/local/bin is
    Intel. Leaving both listed is harmless.
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- QC is background work; keep it off the cores the editor is using. -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>/Users/Shared/BurninghouseQC/qc_root/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/Shared/BurninghouseQC/qc_root/launchd.err.log</string>
</dict>
</plist>
